{
  "name": "atv-world",
  "private": true,
  "version": "0.1.0",
  "description": "ATV World: an open pixel-art city that anyone builds on with their AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test:hq": "node --test tests/hq.test.cjs",
    "test:kittens": "node tests/kittens-browser.mjs",
    "test:ideas": "node tests/idea-machine-browser.mjs",
    "test:steph": "node tests/steph-browser.mjs",
    "test:library": "node --experimental-strip-types --test tests/library.test.ts && node tests/library-browser.mjs"
  },
  "dependencies": {
    "@fluidframework/azure-client": "^1.2.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@microsoft/live-share": "^1.4.2",
    "@microsoft/teams-js": "^2.58.0",
    "fluid-framework": "^1.4.0",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
